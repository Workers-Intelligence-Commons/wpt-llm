# Copy to .env (git-ignored) and fill in.

# Where wpt-dataset and wpt-train keep data: a local folder or an S3-compatible bucket.
# For S3, credentials and a non-AWS endpoint come from AWS_ACCESS_KEY_ID,
# AWS_SECRET_ACCESS_KEY and AWS_ENDPOINT_URL.
WPT_STORE=file:///home/user/wpt-store

# Read by the github source drafter for the GitHub API; unset, GitHub answers only a few
# requests an hour, too few for its listing.
GITHUB_TOKEN=

# Used by scripts/sync.py.
WPT_SYNC_HOST=user@machine
WPT_SYNC_DEST=C:/Users/user/Projets/wpt-llm

# The OpenTelemetry backend the commands send each run to, live, over OTLP/HTTP
# (docs/observability.md); unset, a run is only recorded in the store.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Read by deploy/otel-lgtm/compose.yaml. Grafana's admin password: required, never "admin".
WPT_GRAFANA_PASSWORD=
# The address the backend's ports listen on; empty or unset: 127.0.0.1, this machine only.
WPT_OTEL_ADDRESS=

# Read by wpt-train from the environment, else from this file, and passed on by
# deploy/manager/compose.yaml (docs/machines.md). The gpu workers' keys
# (wpt-worker://TOKEN@HOST:PORT#PIN, which each worker prints; one worker per machine),
# separated by spaces; for wpt-manager, a number instead: how many gpu workers it rents.
# Unset, wpt-train starts a local gpu worker on this machine.
WPT_GPU_WORKERS=
# Read by wpt-manager, to rent gpu workers (docs/machines.md, "Rented gpu workers"):
# who rents them (unset: skypilot), on-demand (unset) or interruptible, what each
# machine has in the provider's words (SkyPilot: H100:8), how many seconds a rented
# worker has to give its address (unset: 1800), and how many times a run resumes after
# a lost gpu worker (unset: 3). A provider's own keys go here too, as it names them.
WPT_RENTAL_PROVIDER=
WPT_RENTAL_KIND=
WPT_RENTAL_GPUS=
WPT_RENTAL_WAIT=
WPT_REPLACEMENTS=
# The checkpoints that come back from the gpu worker: step-ends (unset or empty, the
# default) or every.
WPT_LINK_CHECKPOINTS=

# Read by wpt-manager from the environment, else from this file, and by
# deploy/manager/compose.yaml (docs/machines.md).
# The model recipe to train: required.
WPT_RECIPE=
# The run's name; unset, the manager makes one and writes it into wpt-run.txt.
WPT_RUN=
# 1: evaluate the model at the end; unset, no evaluation.
WPT_EVALUATE=

# Read by Docker Compose, from this file: which Compose files `docker compose up` uses at the
# repository's root. The manager: deploy/manager/compose.yaml.
COMPOSE_FILE=
# A folder of this machine for the manager's store: mounted in its container at the same path
# (WPT_STORE=file:// and that path). Unset, the store is the volume wpt-store.
WPT_STORE_FOLDER=
# Set by deploy/manager/compose.yaml in the manager's container, not here: a failed run
# then ends with exit code 0, so Docker restarts the container only after a crash.
# WPT_MANAGER_CONTAINER=1
