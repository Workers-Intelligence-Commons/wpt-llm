# Copy to .env (git-ignored) and fill in.

# Where wpt-dataset and wpt-train keep data: a local folder or an S3-compatible bucket.
# For S3, the credentials come from WPT_STORE_ACCESS_KEY_ID and WPT_STORE_SECRET_ACCESS_KEY; the store
# reads no AWS_* setting.
WPT_STORE=file:///home/user/wpt-store
WPT_STORE_ACCESS_KEY_ID=
WPT_STORE_SECRET_ACCESS_KEY=
# Optional: WPT_STORE_SESSION_TOKEN, WPT_STORE_ENDPOINT_URL (a non-AWS endpoint), WPT_STORE_REGION (default us-east-1).

# Read by the github source drafter for the GitHub API; unset, GitHub answers only a few
# requests an hour, too few for its listing.
GITHUB_TOKEN=

# Used by scripts/sync.py.
WPT_SYNC_HOST=user@machine
WPT_SYNC_DEST=C:/Users/user/Projets/wpt-llm

# The OpenTelemetry backend the commands send each run to, live, over OTLP/HTTP
# (docs/observability.md); unset, a run is only recorded in the store.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Read by deploy/otel-lgtm/compose.yaml. Grafana's admin password: required, never "admin".
WPT_GRAFANA_PASSWORD=
# The address the backend's ports listen on; empty or unset: 127.0.0.1, this machine only.
WPT_OTEL_ADDRESS=
