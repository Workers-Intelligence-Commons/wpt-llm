{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/inayayousfi/wpt-llm/schemas/dataset.schema.json",
  "title": "WPT dataset recipe (data/recipes/datasets/<name>.json)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "mixture", "tokenizer", "total_tokens", "held_out"],
  "properties": {
    "schema": {"const": 1},
    "mixture": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$", "description": "a file name in data/recipes/mixtures/, without .json"},
    "tokenizer": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$", "description": "a file name in data/recipes/tokenizers/, without .json"},
    "total_tokens": {"type": "integer", "minimum": 1},
    "held_out": {"type": "number", "minimum": 0, "exclusiveMaximum": 1, "description": "share of every source's documents kept out of training"},
    "note": {"type": "string"}
  }
}
