{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Workers-Intelligence-Commons/wpt-llm/schemas/conversation.schema.json",
  "title": "WPT conversation (one line of a file in the chat format; docs/chat-format.md)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "messages"],
  "properties": {
    "schema": {"const": 3, "description": "shape version of the conversation"},
    "metadata": {"type": "object", "description": "what identifies the conversation where it was recorded, such as a post-training attempt's step, task and round; never read as tokens"},
    "tools": {
      "type": "array",
      "description": "the tools offered in the conversation",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "description", "parameters"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "description": {"type": "string"},
          "parameters": {"type": "object", "description": "the JSON Schema of the call's arguments"}
        }
      }
    },
    "messages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "content"],
        "properties": {
          "role": {"enum": ["system", "user", "assistant", "tool"]},
          "content": {"type": "array", "items": {"$ref": "#/$defs/block"}},
          "metadata": {
            "type": "object",
            "description": "what is known about the message where it was recorded; never read as tokens",
            "properties": {"draft": {"$ref": "#/$defs/draft"}}
          }
        },
        "allOf": [
          {"if": {"properties": {"role": {"const": "tool"}}},
           "then": {"properties": {"content": {"items": {"properties": {"type": {"const": "tool_result"}}}}}},
           "else": {"properties": {"content": {"items": {"properties": {"type": {"not": {"const": "tool_result"}}}}}}}},
          {"if": {"properties": {"role": {"const": "assistant"}}},
           "else": {"properties": {"content": {"minItems": 1, "items": {"properties": {"type": {"not": {"enum": ["thinking", "tool_call"]}}}}},
                                   "metadata": {"not": {"required": ["draft"]}}}}}
        ]
      }
    }
  },
  "$defs": {
    "draft": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "weights", "sha256", "edited"],
      "description": "an assistant message that started as a reply drafted by a WPT model, which a person then confirmed, edited or not (docs/chat-format.md, \"Model drafts\")",
      "properties": {
        "model": {"type": "string", "minLength": 1, "description": "the name of the model folder that drafted it"},
        "weights": {"type": "object", "minProperties": 1, "description": "the sha256 of each of that folder's weight files, by file name",
                    "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$", "description": "the sha256 of the drafted content, as wpt_dataset.conversations.content_sha256 computes it"},
        "edited": {"type": "boolean", "description": "true when the person changed the draft before confirming it: the content no longer gives sha256"}
      }
    },
    "block": {
      "type": "object",
      "required": ["type"],
      "properties": {"type": {"enum": ["text", "thinking", "tool_call", "tool_result", "json", "file"]}},
      "allOf": [
        {"if": {"properties": {"type": {"enum": ["text", "thinking"]}}},
         "then": {"additionalProperties": false, "required": ["type", "text"],
                  "properties": {"type": true, "text": {"type": "string"}}}},
        {"if": {"properties": {"type": {"const": "tool_call"}}},
         "then": {"additionalProperties": false, "required": ["type", "id", "name", "arguments"],
                  "properties": {"type": true, "id": {"type": "string", "minLength": 1},
                                 "name": {"type": "string", "minLength": 1}, "arguments": {"type": "object"}}}},
        {"if": {"properties": {"type": {"const": "tool_result"}}},
         "then": {"additionalProperties": false, "required": ["type", "call", "content"],
                  "properties": {"type": true, "call": {"type": "string", "minLength": 1}, "error": {"type": "boolean"},
                                 "content": {"type": "array", "items": {"$ref": "#/$defs/block",
                                             "properties": {"type": {"enum": ["text", "json", "file"]}}}}}}},
        {"if": {"properties": {"type": {"const": "json"}}},
         "then": {"additionalProperties": false, "required": ["type", "value"],
                  "properties": {"type": true, "value": true}}},
        {"if": {"properties": {"type": {"const": "file"}}},
         "then": {"additionalProperties": false, "required": ["type", "sha256", "media_type"],
                  "properties": {"type": true, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                                 "media_type": {"type": "string", "pattern": "^[a-z]+/[A-Za-z0-9.+-]+$"}}}}
      ]
    }
  }
}
