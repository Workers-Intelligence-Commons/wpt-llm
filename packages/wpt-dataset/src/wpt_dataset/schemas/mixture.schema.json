{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Workers-Intelligence-Commons/wpt-llm/schemas/mixture.schema.json",
  "title": "WPT mixture (data/recipes/mixtures/<name>.json)",
  "type": "object",
  "additionalProperties": false,
  "required": ["pools"],
  "properties": {
    "pools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "select", "weight"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
          "select": {"type": "string", "minLength": 1, "description": "tag expression: tags, &&, ||, !( ) and parentheses"},
          "weight": {"type": "number", "exclusiveMinimum": 0, "maximum": 1, "description": "share of the dataset's total tokens"},
          "max_epochs": {"type": "number", "exclusiveMinimum": 0, "description": "how many passes over the pool are allowed (default 4)"},
          "note": {"type": "string"}
        }
      }
    },
    "note": {"type": "string"}
  }
}
