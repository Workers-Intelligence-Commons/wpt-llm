{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/inayayousfi/wpt-llm/schemas/source.schema.json",
  "title": "WPT source description (data/sources/<id>/source.json)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "type", "address", "revision", "checksum", "licenses", "decision"],
  "properties": {
    "schema": {"const": 2, "description": "shape version of this file, for migrations"},
    "type": {"enum": ["http-file", "http-archive", "git", "mercurial", "empty"], "description": "empty: no upstream; the patches hold every file (text written for WPT)"},
    "address": {"type": "string", "minLength": 1, "description": "where to fetch it; its sha256 gives the id's hash part"},
    "revision": {"type": "string", "minLength": 1, "description": "git/mercurial: full commit hash; http: fetch date YYYY-MM-DD; empty: the date the source was started"},
    "checksum": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "description": "sha256 of the canonical manifest"},
    "extract": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "strip": {"type": "integer", "minimum": 0, "description": "leading path components removed from every path"},
        "exclude": {"type": "array", "items": {"$ref": "#/$defs/glob"}, "description": "paths (after strip) left out"},
        "name": {"type": "string", "minLength": 1, "description": "http-file only: the file's path in the manifest"},
        "note": {"type": "string"}
      }
    },
    "licenses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["license", "paths", "attribution"],
        "properties": {
          "license": {"type": "string", "pattern": "^[A-Za-z0-9.+-]+$", "description": "SPDX identifier, or LicenseRef-<name>"},
          "paths": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/glob"}},
          "attribution": {"type": "string", "minLength": 1, "description": "the credit this license asks for, written by a person: authors, title, copyright line, link"},
          "note": {"type": "string"}
        }
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tags", "paths"],
        "properties": {
          "tags": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"}},
          "paths": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/glob"}},
          "note": {"type": "string"}
        }
      }
    },
    "mirrors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["address"],
        "properties": {"address": {"type": "string", "minLength": 1}, "note": {"type": "string"}}
      }
    },
    "cuts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "start", "end", "sha256_after"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "start": {"type": "integer", "minimum": 0, "description": "first removed byte"},
          "end": {"type": "integer", "minimum": 0, "description": "first byte kept after the cut"},
          "sha256_after": {"type": "string", "pattern": "^[0-9a-f]{64}$", "description": "sha256 of the whole file after the cut"},
          "note": {"type": "string"}
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "by", "date", "reason"],
      "properties": {
        "decision": {"enum": ["admitted", "refused", "retired"]},
        "by": {"type": "string", "minLength": 1},
        "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "reason": {"type": "string", "minLength": 1},
        "note": {"type": "string"}
      }
    },
    "note": {"type": "string"}
  },
  "allOf": [
    {
      "if": {"properties": {"type": {"const": "git"}}},
      "then": {"properties": {"revision": {"pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"}}}
    },
    {
      "if": {"properties": {"type": {"const": "mercurial"}}},
      "then": {"properties": {"revision": {"pattern": "^[0-9a-f]{40}$"}}}
    },
    {
      "if": {"properties": {"type": {"enum": ["http-file", "http-archive", "empty"]}}},
      "then": {"properties": {"revision": {"pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}}}
    },
    {
      "if": {"properties": {"type": {"const": "empty"}}},
      "then": {
        "properties": {
          "address": {"pattern": "^empty:[a-z0-9][a-z0-9._-]*$", "description": "empty:<name>, a name for the source; nothing is fetched"},
          "checksum": {"const": "sha256:e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", "description": "the checksum of an empty manifest"}
        },
        "not": {"anyOf": [{"required": ["extract"]}, {"required": ["mirrors"]}]}
      }
    },
    {
      "if": {"properties": {"type": {"not": {"const": "http-file"}}}},
      "then": {"properties": {"extract": {"not": {"required": ["name"]}}}}
    }
  ],
  "$defs": {
    "glob": {"type": "string", "minLength": 1, "description": "path pattern: * matches within one folder, ** across folders"}
  }
}
